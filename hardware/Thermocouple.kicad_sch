		)
		(uuid "d4eece9b-abfe-4900-b8d0-e856b2566141")
	)
	(text "K-type: ~41 uV/C. T = NIST K-type inverse(V_tc + V(T_cj)). Use the NIST polynomial or a lookup table.\nOpen TC: bias resistors in each channel pull the input to full scale -> reading pinned at +FS = 'TC open' fault.\nCAN: module temp at 2 Hz; validity bit per channel; board temp optional (from ADS1118 internal sensor)."
		(exclude_from_sim no)
		(at 36.830000000000005 105.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
