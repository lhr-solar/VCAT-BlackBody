		)
		(uuid "4059474c-b737-4c7a-a968-91e8a8379213")
	)
	(text "TP on SPI_SCK, SPI_MISO, SPI_MOSI, TC_ADC_CS.\nAdd TPD2EUSB30 on the SPI test points\n(same as strain gauge: SCK+MOSI, MISO+CS)."
		(exclude_from_sim no)
		(at 207.01000000000002 26.669999999999998 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "053a9cbf-e08a-4e8f-b5d3-238bbb4cd2f2")
	)
