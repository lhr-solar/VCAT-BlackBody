	(text "J?: harness to the irradiance breakout (2nd PCB).\nPins: PD_A, PD_K (twisted pair), BRK_DET, GNDA, SHIELD.\nUse an LHRS Nano-Fit symbol (ask harness lead for count).\n\nSHIELD: 0R to GND (fit) + 0R to GNDA (DNP),\nsame scheme as the strain gauge J8.\nTerminate the shield at THIS end only.\n\nBRK_DET: breakout ties it to GNDA.\n10k pull-up to +3.3V here -> IRRAD_DET.\nHigh = breakout missing (fault flag)."
		(exclude_from_sim no)
		(at 36.830000000000005 26.669999999999998 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6dc1751c-e3b4-42a7-98b4-045490b15c98")
	)
