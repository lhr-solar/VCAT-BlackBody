	)
	(text "J?: same Nano-Fit series as the main board end.\nPD_A, PD_K (twisted pair), BRK_DET, GNDA, SHIELD.\n\nBRK_DET: tie to GNDA on THIS board so the main\nboard can detect a missing/unplugged breakout.\nSHIELD: leave unconnected here (terminated at the\nmain board only)."
		(exclude_from_sim no)
		(at 107.95 31.75 0)
